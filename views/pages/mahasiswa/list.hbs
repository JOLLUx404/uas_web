<div class="d-flex justify-content-between mb-3">
    <h1>List Mahasiswa</h1>
    
    <a href="/mahasiswa/create" class="btn btn-success mb-3">Tambah Mahasiswa</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>NIM</th>
            <th>Nama</th>
            <th>Email</th>
            <th>Fakultas</th>
            <th>Program Studi</th>
            <th>Angkatan</th>
            <th>Kelas</th>
            <th colspan="2">Actions</th>
        </tr>
    </thead>
    <tbody>
        {{#unless mahasiswa.length }}
        <tr>
            <td colspan="9" class="text-center">
                Tidak ada mahasiswa yang ditemukan <br>
                <a href="/mahasiswa/create" class="link">Tambah Mahasiswa</a>
            </td>
        </tr>
        {{/unless}}

        <!-- Mahasiswa data will be populated here -->
        {{#each mahasiswa}}
        <tr>
            <td>{{this.nim}}</td>
            <td>{{this.nama}}</td>
            <td>{{this.email}}</td>
            <td>{{this.fakultas}}</td>
            <td>{{this.program_studi}}</td>
            <td>{{this.angkatan}}</td>
            <td>{{#if this.nama_kelas}}{{this.nama_kelas}}{{else}}Belum ditentukan{{/if}}</td>
            <td>
                <a href="/mahasiswa/edit/{{this.id}}" class="btn btn-warning w-100">Edit</a>
            </td>
            <td>
                <form action="/mahasiswa/delete/{{this.id}}" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this mahasiswa?');">
                    <button type="submit" class="btn btn-danger w-100">Delete</button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="9" class="text-center">Total Mahasiswa: {{mahasiswa.length}}</td>
        </tr>
    </tfoot>
</table>