<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <i data-lucide="calendar-clock" class="text-primary" width="28" height="28"></i> Bimbingan Akademik
        </h2>
        <p class="text-muted mt-2 mb-0">Ajukan jadwal bimbingan bulanan dan lihat hasil keputusan dari dosen pembimbing.</p>
    </div>
</div>

{{#if kelas}}
<div class="row g-4">
    <div class="col-md-4">
        {{#if isKomting}}
        <div class="card border-0 shadow-sm animate-fade-in-up border-top border-3 border-success h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
                    <div class="bg-success bg-opacity-10 p-2 rounded text-success">
                        <i data-lucide="calendar-plus" width="20" height="20"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-0 text-success">Panel Komting</h5>
                </div>
                
                <p class="text-muted small mb-4">Silakan ajukan jadwal bimbingan untuk kelas Anda.</p>
                
                <form action="/mahasiswa-panel/request-bimbingan" method="POST" id="requestForm">
                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold">Tanggal Konsultasi</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i data-lucide="calendar-days" width="18" height="18"></i></span>
                            <input type="date" class="form-control border-start-0 ps-0" name="tanggal" id="tanggalInput" required>
                        </div>
                        <div class="form-text small">Hanya Senin - Jumat.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted fw-semibold">Jam Bimbingan</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i data-lucide="clock" width="18" height="18"></i></span>
                            <input type="time" class="form-control border-start-0 ps-0" name="jam" id="jamInput" min="13:00" max="19:00" required>
                        </div>
                        <div class="form-text small">Hanya pukul 13:00 s.d 19:00 WIB.</div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-2 rounded-pill shadow-sm">
                        <i data-lucide="send" width="18" height="18"></i> Ajukan Bimbingan Kelas
                    </button>
                </form>
            </div>
        </div>
        {{else}}
        <div class="card border-0 shadow-sm animate-fade-in-up border-top border-3 border-warning h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
                    <div class="bg-warning bg-opacity-10 p-2 rounded text-warning">
                        <i data-lucide="shield-alert" width="20" height="20"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-0 text-warning">Status Kelas</h5>
                </div>
                
                <p class="text-muted">Hanya <strong class="text-dark">Komisaris Tingkat (Komting)</strong> kelas yang memiliki wewenang untuk mengajukan jadwal bimbingan ke Dosen Pembimbing.</p>
                <hr class="text-muted opacity-25">
                <div>
                    <small class="text-muted fw-medium d-block mb-2">Komting Kelas Anda</small>
                    {{#if kelas.nama_komting}}
                        <div class="fw-semibold text-dark">{{kelas.nama_komting}}</div>
                        <div class="small text-muted">{{kelas.nim_komting}}</div>
                    {{else}}
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Belum Ditunjuk</span>
                    {{/if}}
                </div>
            </div>
        </div>
        {{/if}}
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm animate-fade-in-up animate-delay-100 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
                    <div class="bg-info bg-opacity-10 p-2 rounded text-info">
                        <i data-lucide="history" width="20" height="20"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-0">Riwayat Pengajuan Bimbingan</h5>
                </div>
                
                <div class="timeline-container">
                {{#if bimbinganList.length}}
                    <div class="list-group list-group-flush gap-3">
                        {{#each bimbinganList}}
                        <div class="list-group-item list-group-item-action border rounded-3 p-4 shadow-sm border-0 bg-light">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-white p-2 rounded shadow-sm text-primary">
                                        <i data-lucide="calendar" width="20" height="20"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">{{this.tanggal}}</h6>
                                        <small class="text-muted"><i data-lucide="clock" width="12" height="12" class="me-1"></i>{{this.jam}} WIB</small>
                                    </div>
                                </div>
                                <span class="badge px-3 py-2 rounded-pill {{#if (eq this.status 'diterima')}}bg-primary{{else if (eq this.status 'selesai')}}bg-success{{else if (eq this.status 'ditolak')}}bg-danger{{else}}bg-warning text-dark{{/if}}">
                                    {{this.status}}
                                </span>
                            </div>
                            
                            {{#if this.catatan}}
                                <div class="mt-3 p-3 bg-white rounded-3 border-start border-4 border-info shadow-sm">
                                    <small class="fw-bold text-info d-block mb-1">Catatan Dosen:</small>
                                    <p class="mb-0 text-dark">{{this.catatan}}</p>
                                </div>
                            {{else}}
                                {{#if (eq this.status 'selesai')}}
                                <div class="mt-3 p-3 bg-white rounded-3 border-start border-4 border-secondary shadow-sm">
                                    <small class="fw-bold text-secondary d-block mb-1">Catatan Dosen:</small>
                                    <em class="mb-0 text-muted small">Tidak ada catatan tertulis.</em>
                                </div>
                                {{/if}}
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="text-center py-5">
                        <i data-lucide="calendar-x" class="text-muted opacity-50 mb-3" width="48" height="48"></i>
                        <p class="text-muted fw-medium mb-0">Belum ada pengajuan bimbingan kelas yang diajukan.</p>
                    </div>
                {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>
{{else}}
<div class="alert alert-warning border-warning border-opacity-50 shadow-sm d-flex align-items-center gap-3 p-4 animate-fade-in-up">
    <i data-lucide="alert-circle" class="text-warning" width="24" height="24"></i>
    <div>
        <h5 class="alert-heading fw-bold mb-1">Belum Terdaftar di Kelas</h5>
        <p class="mb-0 text-dark">Anda belum terdaftar di kelas bimbingan manapun. Silakan hubungi Admin untuk ditambahkan ke dalam kelas.</p>
    </div>
</div>
{{/if}}

<script>
document.addEventListener('DOMContentLoaded', () => {
    const tanggalInput = document.getElementById('tanggalInput');
    const jamInput = document.getElementById('jamInput');
    const form = document.getElementById('requestForm');

    if (tanggalInput) {
        tanggalInput.addEventListener('input', function() {
            if (!this.value) return;
            const parts = this.value.split('-');
            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const day = parseInt(parts[2], 10);
            const dateVal = new Date(year, month, day);
            const dayOfWeek = dateVal.getDay(); // 0 is Sunday, 6 is Saturday
            
            if (dayOfWeek === 0 || dayOfWeek === 6) {
                alert('Bimbingan tidak dapat diajukan pada hari Sabtu atau Minggu.');
                this.value = '';
            }
        });
    }

    if (jamInput) {
        jamInput.addEventListener('input', function() {
            const timeVal = this.value; // HH:MM
            if (timeVal) {
                const [hour, min] = timeVal.split(':').map(Number);
                if (hour < 13 || hour > 19 || (hour === 19 && min > 0)) {
                    alert('Jam bimbingan hanya diperbolehkan antara pukul 13:00 sampai 19:00.');
                    this.value = '';
                }
            }
        });
    }

    if (form) {
        form.addEventListener('submit', function(e) {
            if (!tanggalInput.value || !jamInput.value) return;
            
            const parts = tanggalInput.value.split('-');
            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const day = parseInt(parts[2], 10);
            const dateVal = new Date(year, month, day);
            const dayOfWeek = dateVal.getDay();
            
            if (dayOfWeek === 0 || dayOfWeek === 6) {
                alert('Tanggal tidak valid (Sabtu/Minggu).');
                e.preventDefault();
                return;
            }

            const timeVal = jamInput.value;
            const [hour, min] = timeVal.split(':').map(Number);
            if (hour < 13 || hour > 19 || (hour === 19 && min > 0)) {
                alert('Jam tidak valid (harus antara 13:00 - 19:00).');
                e.preventDefault();
                return;
            }
        });
    }
});
</script>
