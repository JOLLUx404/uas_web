<div class="mb-4">
    <div class="d-flex justify-content-between">
        <h1>Detail Kelas Bimbingan</h1>
        <div>
            <a href="/kelas/list" class="btn btn-secondary">Kembali</a>
            <a href="/kelas/edit/{{kelas.id}}" class="btn btn-warning">Edit Kelas</a>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        Informasi Kelas
    </div>
    <div class="card-body">
        <table class="table table-borderless mb-0">
            <tr>
                <th width="200">Nama Kelas</th>
                <td>: {{kelas.nama_kelas}}</td>
            </tr>
            <tr>
                <th>Fakultas</th>
                <td>: {{kelas.fakultas}}</td>
            </tr>
            <tr>
                <th>Program Studi</th>
                <td>: {{kelas.program_studi}}</td>
            </tr>
            <tr>
                <th>Angkatan</th>
                <td>: {{kelas.angkatan}}</td>
            </tr>
            <tr>
                <th>Dosen Pembimbing</th>
                <td>: {{kelas.nama_dosen}} (NIDN: {{kelas.nidn}})</td>
            </tr>
            <tr>
                <th>Komting</th>
                <td>: 
                    {{#if kelas.nama_komting}}
                        {{kelas.nama_komting}} (NIM: {{kelas.nim_komting}})
                    {{else}}
                        <span class="text-danger">Belum Ditunjuk</span>
                    {{/if}}
                </td>
            </tr>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                Daftar Mahasiswa
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                {{#if mahasiswaList.length}}
                    <ul class="list-group list-group-flush">
                        {{#each mahasiswaList}}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            {{this.nama}}
                            <span class="badge bg-secondary rounded-pill">{{this.nim}}</span>
                        </li>
                        {{/each}}
                    </ul>
                {{else}}
                    <p class="text-muted text-center my-3">Belum ada mahasiswa di kelas ini.</p>
                {{/if}}
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                Riwayat Bimbingan
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                {{#if bimbinganList.length}}
                    <div class="list-group">
                        {{#each bimbinganList}}
                        <div class="list-group-item list-group-item-action flex-column align-items-start">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">Tanggal: {{this.tanggal}} (Jam: {{this.jam}})</h6>
                                <small class="text-muted">Status: 
                                    <span class="badge {{#if (eq this.status 'disetujui')}}bg-success{{else if (eq this.status 'ditolak')}}bg-danger{{else}}bg-warning text-dark{{/if}}">
                                        {{this.status}}
                                    </span>
                                </small>
                            </div>
                            <p class="mb-1 mt-2"><strong>Catatan:</strong> {{#if this.catatan}}{{this.catatan}}{{else}}<span class="text-muted">Tidak ada catatan</span>{{/if}}</p>
                        </div>
                        {{/each}}
                    </div>
                {{else}}
                    <p class="text-muted text-center my-3">Belum ada riwayat bimbingan.</p>
                {{/if}}
            </div>
        </div>
    </div>
</div>
