<div class="mb-4">
    <div class="d-flex justify-content-between">
        <h1>Detail Kelas Bimbingan</h1>
        <a href="/dosen-panel/data-kelas" class="btn btn-secondary">Kembali</a>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                Informasi Kelas
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th width="150">Nama Kelas</th>
                        <td>: {{kelas.nama_kelas}}</td>
                    </tr>
                    <tr>
                        <th>Fakultas</th>
                        <td>: {{kelas.fakultas}}</td>
                    </tr>
                    <tr>
                        <th>Program Studi</th>
                        <td>: {{kelas.program_studi}}</td>
                    </tr>
                    <tr>
                        <th>Angkatan</th>
                        <td>: {{kelas.angkatan}}</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-warning text-dark">
                Tentukan Komisaris Tingkat (Komting)
            </div>
            <div class="card-body">
                <form action="/dosen-panel/data-kelas/{{kelas.id}}/assign-komting" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Pilih Mahasiswa</label>
                        <select class="form-select" name="komting_id">
                            <option value="">-- Batalkan Komting / Pilih --</option>
                            {{#each mahasiswaList}}
                                <option value="{{this.mahasiswa_id}}" {{#if (eq this.mahasiswa_id ../kelas.komting_id)}}selected{{/if}}>
                                    {{this.nama}} ({{this.nim}})
                                </option>
                            {{/each}}
                        </select>
                        <div class="form-text">Komting terpilih akan memiliki akses untuk mengajukan jadwal konsultasi bimbingan kelas.</div>
                    </div>
                    <button class="btn btn-success w-100" type="submit">Simpan Komting</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                Daftar Mahasiswa Kelas Bimbingan
            </div>
            <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                {{#if mahasiswaList.length}}
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>NIM</th>
                                <th>Nama</th>
                                <th>Email</th>
                                <th>Peran</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each mahasiswaList}}
                            <tr>
                                <td>{{this.nim}}</td>
                                <td>{{this.nama}}</td>
                                <td>{{this.email}}</td>
                                <td>
                                    {{#if (eq this.mahasiswa_id ../kelas.komting_id)}}
                                        <span class="badge bg-warning text-dark">Komting</span>
                                    {{else}}
                                        <span class="text-muted">Anggota</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                {{else}}
                    <p class="text-muted text-center my-4">Belum ada mahasiswa yang masuk ke kelas bimbingan ini.</p>
                {{/if}}
            </div>
        </div>
    </div>
</div>
