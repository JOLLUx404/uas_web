<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Bimbingan Akademik</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Sistem Bimbingan Akademik</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    
                    {{#if (eq user.peran 'admin')}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Data Master (Admin)
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/dosen/list">Dosen</a></li>
                            <li><a class="dropdown-item" href="/mahasiswa/list">Mahasiswa</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/admin/list">Admin</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/kelas/list">Manajemen Kelas</a>
                    </li>
                    {{/if}}

                    {{#if (eq user.peran 'dosen')}}
                    <li class="nav-item">
                        <a class="nav-link" href="/dosen-panel/dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dosen-panel/data-kelas">Data Kelas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dosen-panel/bimbingan">Bimbingan</a>
                    </li>
                    {{/if}}

                    {{#if (eq user.peran 'mahasiswa')}}
                    <li class="nav-item">
                        <a class="nav-link" href="/mahasiswa-panel/dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/mahasiswa-panel/data-kelas">Data Kelas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/mahasiswa-panel/bimbingan">Bimbingan</a>
                    </li>
                    {{/if}}

                </ul>
                {{#if user.nama}}
                <span class="navbar-text me-3 text-dark">
                    Halo, <strong>{{user.nama}}</strong> (Role: <span class="badge bg-secondary">{{user.peran}}</span>)
                </span>
                {{/if}}
            </div>
        </div>
    </nav>

    <div class="container py-4">
        {{{body}}}
    </div>

    <!-- Tambahkan script Bootstrap JS -->
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>